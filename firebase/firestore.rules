rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeamMember(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.status == "active";
    }

    function isCoach(teamId) {
      return isTeamMember(teamId)
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "coach";
    }

    function isPlayer(teamId) {
      return isTeamMember(teamId)
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "player";
    }

    // ==================== USERS ====================

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false; // Users cannot delete themselves via Firestore
    }

    // ==================== TEAMS ====================

    match /teams/{teamId} {
      allow read: if isSignedIn() && isTeamMember(teamId);
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'createdAt', 'createdBy', 'joinCode', 'playbookVersion']);
      allow update: if isSignedIn() && isCoach(teamId);
      allow delete: if isSignedIn() && isCoach(teamId);

      // ==================== TEAM MEMBERS ====================

      match /members/{memberId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow create: if isSignedIn()
          && (
            // Self-join as player via code
            (request.auth.uid == memberId && request.resource.data.role == "player")
            // Coach creates membership
            || isCoach(teamId)
          );
        allow update: if isSignedIn() && isCoach(teamId);
        allow delete: if isSignedIn() && isCoach(teamId);
      }

      // ==================== SETS (OFFENSE) ====================

      match /sets/{setId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow create: if isSignedIn() && isCoach(teamId)
          && request.resource.data.keys().hasAll(['name', 'category', 'isTemplate', 'updatedAt', 'steps']);
        allow update: if isSignedIn() && isCoach(teamId);
        allow delete: if isSignedIn() && isCoach(teamId);
      }

      // ==================== DEFENSE SCENARIOS ====================

      match /defense/{scenarioId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow create: if isSignedIn() && isCoach(teamId)
          && request.resource.data.keys().hasAll(['name', 'category', 'isTemplate', 'updatedAt', 'steps']);
        allow update: if isSignedIn() && isCoach(teamId);
        allow delete: if isSignedIn() && isCoach(teamId);
      }

      // ==================== PRACTICES ====================

      match /practices/{practiceId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow create: if isSignedIn() && isCoach(teamId)
          && request.resource.data.keys().hasAll(['title', 'updatedAt']);
        allow update: if isSignedIn() && isCoach(teamId);
        allow delete: if isSignedIn() && isCoach(teamId);
      }

      // ==================== NOTES ====================

      match /notes/{noteId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow create: if isSignedIn() && isCoach(teamId)
          && request.resource.data.keys().hasAll(['attachmentType', 'attachmentId', 'targetType', 'createdBy', 'createdAt', 'updatedAt']);
        allow update: if isSignedIn() && isCoach(teamId);
        allow delete: if isSignedIn() && isCoach(teamId);
      }

      // ==================== FILM REFERENCES ====================

      match /film/{filmId} {
        allow read: if isSignedIn() && isTeamMember(teamId);
        allow create: if isSignedIn() && isCoach(teamId)
          && request.resource.data.keys().hasAll(['attachmentType', 'attachmentId', 'targetType', 'url', 'createdBy', 'createdAt', 'updatedAt']);
        allow update: if isSignedIn() && isCoach(teamId);
        allow delete: if isSignedIn() && isCoach(teamId);
      }
    }
  }
}
