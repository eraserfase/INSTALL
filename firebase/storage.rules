rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper to check if user is a team member
    function isTeamMember(teamId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.status == "active";
    }

    // Helper to check if user is a coach
    function isCoach(teamId) {
      return isTeamMember(teamId)
        && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "coach";
    }

    // ==================== AUDIO NOTES ====================
    // Path: teams/{teamId}/notes/{noteId}/audio.{ext}

    match /teams/{teamId}/notes/{noteId}/{fileName} {
      // Only coaches can upload audio notes
      allow write: if request.auth != null && isCoach(teamId)
        && request.resource.size < 10 * 1024 * 1024  // Max 10MB
        && request.resource.contentType.matches('audio/.*');

      // Team members can read audio notes
      allow read: if request.auth != null && isTeamMember(teamId);
    }

    // ==================== FILM AUDIO NOTES ====================
    // Path: teams/{teamId}/film/{filmId}/audio.{ext}

    match /teams/{teamId}/film/{filmId}/{fileName} {
      // Only coaches can upload film audio notes
      allow write: if request.auth != null && isCoach(teamId)
        && request.resource.size < 10 * 1024 * 1024  // Max 10MB
        && request.resource.contentType.matches('audio/.*');

      // Team members can read film audio notes
      allow read: if request.auth != null && isTeamMember(teamId);
    }

    // Catch-all: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
